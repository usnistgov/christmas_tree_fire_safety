from browser import window, document

jq = window.jQuery
Bokeh = window.Bokeh
math = window.Math
JSON = window.JSON

def to_js_array(py_list):
    """Convert Python list to JavaScript array."""
    return JSON.parse(JSON.stringify(py_list))


def qcalc(phrr, n, Etot, tdelay):
    """
    this function calculates a new array of HRR values for the graph
    """
    tn = 2 * n
    r = (1 - 1 / tn) ** (1 - tn)
    k = (phrr / (Etot * 1000)) * r
    t = 0
    tlist = []  # time list
    q = []

    while t < (tdelay):
        q.append(0)
        tlist.append(t)
        t = round(t + 0.1, 1)

    while t >= (tdelay) and t < (120):
        q.append(
            phrr * tn * r * ((1 - math.exp(-k * (t - tdelay))) ** (tn - 1)) * math.exp(-k * (t - tdelay))
        )
        tlist.append(t)
        t = round(t + 0.1, 1)

    # Find index of the first negative q, chop it off
    negatives = [i for i, rx in enumerate(q) if rx < 0]
    if negatives:
        end = negatives[0]
        q = q[:end]
        tlist = tlist[:end]

    q = [round(rx, 2) for rx in q]
    return q, tlist


# Calculate when parameter changed
def update_xy():
    n = float(document["n"].value)
    etot = float(document["etot"].value)
    phrr = float(document["PHRR"].value)
    tdelay = float(document["tdelay"].value)

    document["n_out"].value = n
    document["etot_out"].value = etot
    document["phrr_out"].value = phrr
    document["tdelay_out"].value = tdelay

    q, t = qcalc(phrr, n, etot, tdelay)
    return t, q


# Initialize Plot
x, y = update_xy()
width = document["myform"].clientWidth

source = Bokeh.ColumnDataSource.new({"data": {"x": to_js_array(x), "y": to_js_array(y)}})

plt = Bokeh.Plotting
fig = plt.figure({
    "tools": "crosshair,box_zoom,reset,save",
    "width": width,
    "height": 400,
    "x_range": [0, 120],
    "y_range": [0, 3500],
    "x_axis_label": "time [s]",
    "y_axis_label": "Heat Release Rate, HRR [kW]",
})

fig.line({"field": "x"}, {"field": "y"}, {"source": source, "line_width": 2, "line_color": "red"})
plt.show(fig, "#myplot")


# Respond to parameter changes
def update(ev):
    x, y = update_xy()
    source.data = {"x": to_js_array(x), "y": to_js_array(y)}


jq("#myform :input").change(update)
